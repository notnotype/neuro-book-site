DATABASE_URL="file:./data.db"
NUXT_SESSION_PASSWORD="replace-with-at-least-48-random-characters"
ADMIN_USERNAME="admin"
# Workshop zip 文件存储根目录（布局 <filesDir>/<itemId>/<ordinal>.zip）
WORKSHOP_FILES_DIR="./data/files"
# 实例加密备份存储根目录（布局 <dir>/<userId>/<backupId>.nbbackup）
NB_BACKUP_DIR="./data/backups"
# 生产 canonical origin 与可信 Docker bridge 网关
NB_SITE_ORIGIN="https://nbook.notnotype.com"
NB_TRUSTED_PROXY_ADDRESSES="172.30.0.1"
NB_PRIVATE_MODE="1"
NB_LOG_LEVEL="info"
# 生产必须使用绝对路径；开发留空时只输出到控制台。
NB_LOG_FILE=""
# Workshop + Backup 全站 6 GiB，物理磁盘必须保留 4 GiB
NB_STORAGE_MAX_BYTES="6442450944"
NB_STORAGE_RESERVED_BYTES="4294967296"
NB_BACKUP_MAX_FILE_BYTES="1073741824"
NB_BACKUP_QUOTA_BYTES="2147483648"
NB_BACKUP_MAX_COUNT="5"
NB_WORKSHOP_MAX_FILE_BYTES="20971520"
NB_WORKSHOP_MAX_UNCOMPRESSED_BYTES="104857600"
NB_WORKSHOP_MAX_ENTRIES="500"
# 私有内测关闭注册和 GitHub OAuth；不要配置 OAuth client secret。
NB_GITHUB_OAUTH_ENABLED="0"
