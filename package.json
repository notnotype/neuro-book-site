{
    "name": "neuro-book-site",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "NeuroBook official site for Passport, Workshop, and encrypted backups.",
    "scripts": {
        "dev": "nuxt prepare && prisma generate && nuxt dev",
        "build": "nuxt prepare && prisma generate && nuxt build && bun run build:runtime-tools",
        "build:runtime-tools": "bun build scripts/ensure-sqlite-db.ts --target=node --format=esm --packages=external --outfile=dist/ensure-sqlite-db.mjs && bun build scripts/init-db.ts --target=node --format=esm --packages=external --outfile=dist/init-db.mjs && bun build scripts/admin-password.ts --target=node --format=esm --packages=external --outfile=dist/admin-password.mjs",
        "preview": "nuxt preview",
        "typecheck": "nuxt prepare && prisma generate && vue-tsc --noEmit",
        "test": "vitest run",
        "db:generate": "prisma generate",
        "db:create": "bun scripts/ensure-sqlite-db.ts",
        "db:deploy": "prisma migrate deploy",
        "db:setup": "prisma generate && bun scripts/ensure-sqlite-db.ts && prisma migrate deploy && bun scripts/init-db.ts",
        "db:migrate:dev": "prisma migrate dev",
        "db:init": "bun scripts/init-db.ts",
        "db:admin": "bun scripts/admin-password.ts"
    },
    "dependencies": {
        "@codemirror/lang-javascript": "^6.2.5",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/theme-one-dark": "^6.1.3",
        "@libsql/client": "^0.17.4",
        "@libsql/isomorphic-ws": "^0.1.5",
        "@notnotype/nb-ui": "github:notnotype/nb-ui#e57c6b6a303a9cd981d761d089ccf7dfcafb1cba",
        "@pinia/nuxt": "^0.11.3",
        "@prisma/adapter-libsql": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "busboy": "^1.6.0",
        "codemirror": "^6.0.2",
        "dompurify": "^3.4.11",
        "dotenv": "^17.4.2",
        "fflate": "^0.8.3",
        "marked": "^18.0.5",
        "nuxt": "^4.3.1",
        "nuxt-auth-utils": "^0.5.29",
        "pinia": "^3.0.4",
        "pino": "^10.3.1",
        "prisma": "^7.8.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@iconify-json/lucide": "^1.2.95",
        "@nuxt/cli": "^3.36.1",
        "@nuxtjs/color-mode": "^4.0.0",
        "@types/busboy": "^1.5.4",
        "@types/node": "^25.6.0",
        "@unocss/nuxt": "^66.6.2",
        "typescript": "^5.9.3",
        "unocss": "^66.6.2",
        "vitest": "^4.1.2",
        "vue": "^3.5.24",
        "vue-tsc": "^2.2.0"
    }
}
